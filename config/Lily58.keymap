#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <7 7>;
            then-layer = <10>;
        };
    };

    combos {
        compatible = "zmk,combos";

        vim-cmd {
            bindings = <&vim_make_cmd>;
            key-positions = <55 54>;
        };

        quota {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <52 51>;
        };
    };

    macros {
        vim_make_cmd: vim_make_cmd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON>, <&macro_press>;

            label = "VIM_MAKE_CMD";
        };
    };

    behaviors {
        spacehold: spacehold {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACEHOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |RGB_TOG|  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC           &kp N1   &kp N2   &kp N3    &kp N4             &kp N5                                                                         &kp PRINTSCREEN        &kp N6    &kp N7     &kp N8   &kp N9              &kp N0
&kp TAB           &kp Q    &kp W    &kp F     &kp P              &kp B                                                                          &kp J                  &kp L     &kp U      &kp Y    &kp MINUS           &kp BACKSLASH
&kp LEFT_SHIFT    &lt 1 A  &lt 3 R  &kp S     &kp T              &kp G                                                                          &kp M                  &kp N     &kp E      &kp I    &kp O               &kp SEMICOLON
&kp LEFT_CONTROL  &kp Z    &kp X    &kp C     &kp D              &kp V                 &mt LS(LC(LA(LGUI))) SQT    &kp LG(ENTER)                &kp K                  &kp H     &kp COMMA  &kp DOT  &mt RIGHT_ALT FSLH  &lt 4 GRAVE
                                    &kp LALT  &kp LC(BACKSPACE)  &mt LEFT_CONTROL ESC  &lt 2 BACKSPACE             &spacehold LEFT_SHIFT SPACE  &spacehold LGUI ENTER  &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        specials {
            bindings = <
&trans  &kp F1  &kp F2           &kp F3       &kp F4           &kp F5                                                       &trans        &kp F6                &kp F7                 &kp F8         &kp F9            &kp F10
&trans  &trans  &kp EXCLAMATION  &kp AT_SIGN  &kp PIPE         &kp TILDE                                                    &trans        &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH  &trans            &kp F11
&trans  &trans  &kp HASH         &kp DOLLAR   &kp EXCLAMATION  &kp AMPERSAND                                                &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN  &kp GREATER_THAN  &kp F12
&trans  &trans  &kp PERCENT      &kp CARET    &kp AMPERSAND    &trans             &trans                         &trans     &trans        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans            &trans
                                 &trans       &trans           &kp DOUBLE_QUOTES  &mt LEFT_CONTROL APOSTROPHE    &kp EQUAL  &kp PLUS      &kp MINUS             &trans
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &to 6                        &trans     &trans           &trans             &trans        &trans           &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans                       &trans     &trans           &trans             &trans        &trans           &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans                       &trans     &kp LEFT_ARROW   &kp DOWN           &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans    &trans     &trans     &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_MUTE    &trans           &trans
                                &trans          &trans           &trans  &trans    &mkp LCLK  &mkp RCLK  &trans           &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &trans  &trans   &trans  &trans                    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans   &trans  &trans                    &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans        &trans
&trans  &trans  &trans  &kp DOT  &trans  &trans                    &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp NUMBER_0  &trans
&trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans  &kp DOT       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans
                        &trans   &trans  &trans  &trans    &trans  &trans        &trans        &trans
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |EXTPWR |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                             &trans     &trans     &trans     &trans    &trans    &trans
&kp F1      &kp F2            &kp F3             &kp F4             &kp F5        &kp F6                                   &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12
&kp GRAVE   &kp EXCL          &kp AT             &kp HASH           &kp DOLLAR    &kp PRCNT                                &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp TILDE
&trans      &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans        &trans        &trans    &rgb_ug RGB_TOG  &trans     &kp MINUS  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                                                 &trans             &trans        &trans        &trans    &trans           &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                       &trans  &trans  &trans  &trans  &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                    &trans  &trans  &trans  &trans  &trans  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans           &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans           &trans           &trans           &trans           &trans           &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                     &trans           &trans           &trans           &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        gaming {
            bindings = <
&trans            &trans  &trans  &trans  &trans  &to 0                        &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB           &kp Q   &kp W   &kp E   &kp E   &kp T                        &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp A   &kp S   &kp D   &kp F   &kp G                        &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C   &kp V   &kp B      &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans  &trans  &kp SPACE  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
    };
};
